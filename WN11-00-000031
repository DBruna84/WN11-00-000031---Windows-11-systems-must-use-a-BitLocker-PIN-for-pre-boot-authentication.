.USAGE
# Create BitLocker policy registry path
New-Item -Path "HKLM:\SOFTWARE\Policies\Microsoft\FVE" -Force | Out-Null

# Require additional authentication at startup
Set-ItemProperty -Path "HKLM:\SOFTWARE\Policies\Microsoft\FVE" `
    -Name "UseAdvancedStartup" `
    -Type DWord `
    -Value 1

# Allow TPM
Set-ItemProperty -Path "HKLM:\SOFTWARE\Policies\Microsoft\FVE" `
    -Name "UseTPM" `
    -Type DWord `
    -Value 2

# Require TPM + PIN
Set-ItemProperty -Path "HKLM:\SOFTWARE\Policies\Microsoft\FVE" `
    -Name "UseTPMPIN" `
    -Type DWord `
    -Value 2

# Do not allow TPM only
Set-ItemProperty -Path "HKLM:\SOFTWARE\Policies\Microsoft\FVE" `
    -Name "UseTPMKey" `
    -Type DWord `
    -Value 0

# Do not allow TPM + Startup Key without PIN
Set-ItemProperty -Path "HKLM:\SOFTWARE\Policies\Microsoft\FVE" `
    -Name "UseTPMKeyPIN" `
    -Type DWord `
    -Value 0

Write-Host "BitLocker TPM+PIN policy configured."

Enable Pin
$SecurePIN = ConvertTo-SecureString "123456" -AsPlainText -Force

Enable-BitLocker `
  -MountPoint "C:" `
  -EncryptionMethod XtsAes256 `
  -UsedSpaceOnly `
  -TpmAndPinProtector `
  -Pin $SecurePIN

Verify
Get-BitLockerVolume | Select-Object MountPoint,ProtectionStatus,KeyProtector

Check again
Get-BitLockerVolume -MountPoint "C:" | Select-Object -ExpandProperty KeyProtector

Remove errors
$BLV = Get-BitLockerVolume -MountPoint "C:"

$BLV.KeyProtector |
Where-Object {$_.KeyProtectorType -eq "TpmPin"} |
ForEach-Object {
    Remove-BitLockerKeyProtector `
      -MountPoint "C:" `
      -KeyProtectorId $_.KeyProtectorId
}

Add or Refresh 
$SecurePIN = ConvertTo-SecureString "123456" -AsPlainText -Force

Add-BitLockerKeyProtector `
    -MountPoint "C:" `
    -TpmAndPinProtector `
    -Pin $SecurePIN

Verify
Get-BitLockerVolume -MountPoint "C:" |
Select-Object -ExpandProperty KeyProtector

Check validation
(Get-BitLockerVolume -MountPoint "C:").KeyProtector
